#usda 1.0
(
    customLayerData = {
        string "aeco:clash:layer" = "Route S wireframe view over exact mesh twins"
    }
)

over "demo_datacentre_01"
{
    over "demo_datacentre_01_Site"
    {
        over "demo_datacentre_01"
        {
            over "L01_Office"
            {
                over "Office_Corridor_L01"
                {
                    over "Corridor_ceiling_void"
                    {
                        over "tray_void_ocorr_1"
                        {
                            over "Geom"
                            {
                                token visibility = "invisible"
                            }

                            over "Body"
                            {
                                token visibility = "inherited"
                            }
                        }

                        over "pipe_clash_hard"
                        {
                            over "Geom"
                            {
                                token visibility = "invisible"
                            }

                            over "Body"
                            {
                                token visibility = "inherited"
                            }
                        }

                        over "pipe_clash_near"
                        {
                            over "Geom"
                            {
                                token visibility = "invisible"
                            }

                            over "Body"
                            {
                                token visibility = "inherited"
                            }
                        }

                        over "pipe_clash_tangent"
                        {
                            over "Geom"
                            {
                                token visibility = "invisible"
                            }

                            over "Body"
                            {
                                token visibility = "inherited"
                            }
                        }
                    }
                }

                over "wall_l1_h_007"
                {
                    over "Geom"
                    {
                        token visibility = "invisible"
                    }

                    over "Body"
                    {
                        token visibility = "inherited"
                    }
                }
